<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Increase limits to handle large OAuth callback query strings (Microsoft code is 2000+ chars) -->
        <requestLimits maxQueryString="65536" maxUrl="65536" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
