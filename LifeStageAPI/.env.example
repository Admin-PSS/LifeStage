# Copy this to .env and fill in real values.
# For local dev, prefer: dotnet user-secrets set "Key" "Value"

# ── Connection String ─────────────────────────────────────────────────────────
ConnectionStrings__DefaultConnection="Server=.;Database=LifeStageDB;Trusted_Connection=True;TrustServerCertificate=True;"

# ── JWT ────────────────────────────────────────────────────────────────────────
Jwt__Secret="replace_with_a_strong_random_secret_at_least_32_chars"
Jwt__Issuer="LifeStageAPI"
Jwt__Audience="NexusApp"
Jwt__ExpiryMinutes="60"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# Redirect URI: https://localhost:7001/api/auth/oauth/google/callback
OAuth__Google__ClientId=""
OAuth__Google__ClientSecret=""

# ── Microsoft OAuth ───────────────────────────────────────────────────────────
# https://portal.azure.com → App registrations
# Redirect URI: https://localhost:7001/api/auth/oauth/microsoft/callback
OAuth__Microsoft__ClientId=""
OAuth__Microsoft__ClientSecret=""

# ── Facebook OAuth ────────────────────────────────────────────────────────────
# https://developers.facebook.com → My Apps
# Redirect URI: https://localhost:7001/api/auth/oauth/facebook/callback
OAuth__Facebook__AppId=""
OAuth__Facebook__AppSecret=""

# ── Twitter / X OAuth ─────────────────────────────────────────────────────────
# https://developer.twitter.com → Projects & Apps
# Redirect URI: https://localhost:7001/api/auth/oauth/twitter/callback
OAuth__Twitter__ConsumerKey=""
OAuth__Twitter__ConsumerSecret=""

# ── LinkedIn OAuth ────────────────────────────────────────────────────────────
# https://www.linkedin.com/developers/apps
# Redirect URI: https://localhost:7001/api/auth/oauth/linkedin/callback
OAuth__LinkedIn__ClientId=""
OAuth__LinkedIn__ClientSecret=""
